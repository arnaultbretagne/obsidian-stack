# Obsidian Sync
OBSIDIAN_AUTH_TOKEN=        # obtenu via `ob login`
VAULT_NAME=                 # nom du vault dans Obsidian Sync
VAULT_HOST_PATH=./vault     # chemin hote pour le bind mount

# Clipper
BROWSER_TIMEOUT_MS=30000
LOG_LEVEL=info
PORT=3000
MODE=server                 # server | cli

# MCP Server
MCP_PORT=4000
MCP_SERVER_URL=https://vault.bretagne.dev
POCKET_ID_ISSUER=https://id.bretagne.dev
