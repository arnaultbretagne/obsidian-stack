# --- Obsidian Sync (first-time setup only; session then persists in sync-config/) ---
OBSIDIAN_AUTH_TOKEN=        # token from `ob login`
VAULT_NAME=                 # vault name in Obsidian Sync
VAULT_HOST_PATH=./vault     # host path bind-mounted at /vault (local dev)

# --- Clipper ---
BROWSER_TIMEOUT_MS=30000
LOG_LEVEL=info
PORT=3000
MODE=server                 # server | cli

# --- MCP server ---
MCP_PORT=4000
MCP_SERVER_URL=https://vault.example.com    # public URL (OAuth resource metadata)
POCKET_ID_ISSUER=https://id.example.com     # OIDC issuer for JWT validation
